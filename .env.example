# For `pnpm dev`/`pnpm build`, copy this file to apps/web/.env (not the repo root) — Next.js loads
# .env from its own project directory, and a root-level .env is silently never read. `pnpm worker`
# needs its own copy at apps/worker/.env for the same reason.
CROSSLINE_DATA_DIR=C:\Users\karol\Documents\ChatGPT\Multi-ID\data
CROSSLINE_SYNC_INTERVAL_MINUTES=15
CROSSLINE_WEB_HEALTH_URL=http://127.0.0.1:3210/api/health
CROSSLINE_CODEX_SUPERVISOR_URL=http://127.0.0.1:3211
# This release supports local loopback operation only. External exposure is blocked at build time
# until per-user authentication and workspace authorization are implemented.
CROSSLINE_DEPLOYMENT_MODE=local
# Required for real login (stage two of the identity plan). Generate a random 32+ byte secret; it signs
# session tokens, so rotating it invalidates every existing session.
BETTER_AUTH_SECRET=
# Defaults to http://127.0.0.1:3210 if unset. Stage six sets CROSSLINE_TAILSCALE_HOSTNAME once the app is
# also reachable over the tailnet, which gets added to the trusted-origins list alongside this one.
CROSSLINE_WEB_BASE_URL=
CROSSLINE_TAILSCALE_HOSTNAME=
# Required only to enable Google sign-in. See docs/user-guide.md for how to create these in Google Cloud
# Console; leaving them blank simply hides the "使用 Google 登录" button.
CROSSLINE_GOOGLE_CLIENT_ID=
CROSSLINE_GOOGLE_CLIENT_SECRET=
# Required only to enable email/password sign-up. All five must be set together — leaving any one blank
# disables email/password sign-up entirely rather than registering an unverifiable account.
CROSSLINE_SMTP_HOST=
CROSSLINE_SMTP_PORT=
CROSSLINE_SMTP_USER=
CROSSLINE_SMTP_PASSWORD=
CROSSLINE_SMTP_FROM=
# Required only when enabling read-only Microsoft Graph import (Gate 2).
# A single-tenant registration must set the tenant id: /common is refused with AADSTS50194.
CROSSLINE_MS_CLIENT_ID=
CROSSLINE_MS_TENANT_ID=
# Required only when enabling the existing content-ops adapter:
CROSSLINE_CONTENT_OPS_URL=
CROSSLINE_CONTENT_OPS_TOKEN=
# Model tiers are capability names, so switching the backing model is one change here.
# Unset means the runtime picks its own default rather than a name invented by this app.
CROSSLINE_MODEL_ROUTINE=
CROSSLINE_MODEL_CAPABLE=
