# For `pnpm dev`/`pnpm build`, copy this file to apps/web/.env (not the repo root) — Next.js loads
# .env from its own project directory, and a root-level .env is silently never read.
# `pnpm worker` is the opposite: `apps/worker/src/index.ts` loads `.env.local`/`.env` from the
# REPO ROOT itself (its own package directory is never read), so the worker's copy of every value
# below — especially CROSSLINE_SUPERVISOR_CAPABILITY_SECRET, which must match apps/web/.env exactly —
# belongs in a root-level `.env.local` (gitignored), not `apps/worker/.env`. Without it the worker logs
# `worker.blocked: CROSSLINE_SUPERVISOR_CAPABILITY_SECRET_MISSING` and the Codex supervisor never binds
# its port, silently — Analyze/material prep/milestone gate/Codex login all just look permanently down.
CROSSLINE_DATA_DIR=C:\Users\karol\Documents\ChatGPT\Multi-ID\data
CROSSLINE_SYNC_INTERVAL_MINUTES=15
CROSSLINE_WEB_HEALTH_URL=http://127.0.0.1:3210/api/health
CROSSLINE_CODEX_SUPERVISOR_URL=http://127.0.0.1:3211
# Required in both apps/web/.env and apps/worker/.env, and must be the SAME value in each — it signs the
# short-lived capability tokens web sends the worker on every Codex supervisor call, so port 3211 refuses
# anything but the web app's own already-authenticated requests. Independent from BETTER_AUTH_SECRET on
# purpose: leaking one must not also compromise the other. Generate a random 32+ byte secret.
CROSSLINE_SUPERVISOR_CAPABILITY_SECRET=
# `local` (plain loopback) or `private` (still loopback — reached from other tailnet devices only through
# `tailscale serve`'s own TLS-terminating reverse proxy; set CROSSLINE_TAILSCALE_HOSTNAME below too, and
# this turns on HSTS/CSP/nosniff/etc response headers, which loopback-only traffic never needed). Public
# internet exposure ("external") is still blocked at build time — see docs/external-deployment.md.
CROSSLINE_DEPLOYMENT_MODE=local
# Required for real login (stage two of the identity plan). Generate a random 32+ byte secret; it signs
# session tokens, so rotating it invalidates every existing session.
BETTER_AUTH_SECRET=
# Defaults to http://127.0.0.1:3210 if unset. Stage six sets CROSSLINE_TAILSCALE_HOSTNAME once the app is
# also reachable over the tailnet, which gets added to the trusted-origins list alongside this one.
CROSSLINE_WEB_BASE_URL=
CROSSLINE_TAILSCALE_HOSTNAME=
# Required only to enable Google sign-in. See docs/user-guide.md for how to create these in Google Cloud
# Console; leaving them blank simply hides the "使用 Google 登录" button.
CROSSLINE_GOOGLE_CLIENT_ID=
CROSSLINE_GOOGLE_CLIENT_SECRET=
# Sign in with ChatGPT for a copy run on your own machine (OpenAI's open-source flow: no client id or secret to configure, the
# install registers itself on first sign-in). Works only when the app is opened at http://127.0.0.1:<port>. Set to 1 to offer it.
CROSSLINE_CHATGPT_SIGNIN=
# Required only to enable email/password sign-up. All five must be set together — leaving any one blank
# disables email/password sign-up entirely rather than registering an unverifiable account.
CROSSLINE_SMTP_HOST=
CROSSLINE_SMTP_PORT=
CROSSLINE_SMTP_USER=
CROSSLINE_SMTP_PASSWORD=
CROSSLINE_SMTP_FROM=
# Required only when enabling read-only Microsoft Graph import (Gate 2).
# A single-tenant registration must set the tenant id: /common is refused with AADSTS50194.
CROSSLINE_MS_CLIENT_ID=
CROSSLINE_MS_TENANT_ID=
# Required only when enabling the existing content-ops adapter:
CROSSLINE_CONTENT_OPS_URL=
CROSSLINE_CONTENT_OPS_TOKEN=
# Model tiers are capability names, so switching the backing model is one change here.
# Unset means the runtime picks its own default rather than a name invented by this app.
CROSSLINE_MODEL_ROUTINE=
CROSSLINE_MODEL_CAPABLE=
