{
  "name": "crossline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @crossline/web dev",
    "worker": "pnpm --filter @crossline/worker dev",
    "worker:start": "pnpm --filter @crossline/worker start",
    "export": "pnpm --filter @crossline/worker export",
    "restore": "pnpm --filter @crossline/worker restore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @crossline/web build",
    "doctor:ledger": "tsx scripts/doctor.ts",
    "test:codex-corpus": "tsx scripts/codex-workflow-corpus.ts --live",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
