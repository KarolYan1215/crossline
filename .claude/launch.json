{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "scripts/review-server.ts"],
      "port": 3320
    },
    {
      "name": "assess",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crossline/assess", "dev"],
      "port": 3340
    },
    {
      "name": "install-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "scripts/install-preview-server.ts"],
      "port": 3330,
      "url": "http://localhost:3330"
    },
    {
      "name": "install-preview-signed-in",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "scripts/install-preview-server.ts", "signed-in", "reset"],
      "port": 3330,
      "url": "http://localhost:3330"
    }
  ]
}
